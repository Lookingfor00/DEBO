# Auth0 (TB-005). Regular Web Application on the Solinet tenant (S8).
# This Next.js app uses @auth0/nextjs-auth0 (server session), not @auth0/auth0-react (SPA).
# In the Auth0 dashboard: Application Type = Regular Web Application
# (not SPA). Token Endpoint Auth Method = POST. Then copy the Client Secret.
# Do not reuse the old DEBO CRA Client ID.
#
# Local:
APP_BASE_URL=http://localhost:3000
# Production (Vercel / jobs.solinet.dev) — no :443, https is implied:
# APP_BASE_URL=https://jobs.solinet.dev
AUTH0_DOMAIN=dev-55mbnrswqskpaqpd.us.auth0.com
AUTH0_CLIENT_ID=8yED7cVOViHfYOQHUFmlCIR2e9NA4bMM
AUTH0_CLIENT_SECRET=
# Cookie encryption. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=

# Public jobs catalogue (TB-002 / S6). Server only — never NEXT_PUBLIC_*.
# Never set SUPABASE_SERVICE_ROLE_KEY or SCRAPER_RUN_KEY in this app.
JOBS_API_URL=http://127.0.0.1:3000/api/public/jobs
JOBS_READ_KEY=

# jobboard.favorites (TB-007 / S5 / S9). Dedicated schema key — not scrape service_role.
JOBBOARD_SUPABASE_URL=
JOBBOARD_SECRET_KEY=

# /pay support contact (PI-010). Server only — never NEXT_PUBLIC_*.
SUPPORT_MSISDN=

# Alerts activation (TB-019). Server only — never NEXT_PUBLIC_*.
# HMAC for httpOnly cookie jobboard_alerts_session after POST /api/alerts/activate.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALERTS_SESSION_SECRET=
# Bearer secret for POST /api/alerts/invalidate (pay APK Settings / PI-013). Not service_role.
ALERTS_INVALIDATE_SECRET=

# Landing contact form (Formspree). Same Debo form as the CRA site.
NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/xzblkrvw

# Public WhatsApp channel / contact for landing step 1.
# Prefer a chat.whatsapp.com invite when available.
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://wa.me/22374469859

